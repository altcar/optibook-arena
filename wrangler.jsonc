{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optibook-arena",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "ArenaEngine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaEngine"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
